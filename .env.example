# ---- Browser build (safe to expose, RLS is the boundary) ----
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ---- Server-side only: seed script and manual admin tasks ----
# Never prefix these with VITE_ and never commit real values.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Initial super admin used by scripts/seed-admins.ts ----
SEED_ADMIN_USERNAME=owner
SEED_ADMIN_FULL_NAME=Platform Owner
SEED_ADMIN_PASSWORD=change-me-to-a-long-unique-password